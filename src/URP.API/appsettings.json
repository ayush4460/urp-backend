{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/urp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=urp_db;Uid=root;Pwd=Ayushzala#19;CharSet=utf8mb4;AllowPublicKeyRetrieval=true;SslMode=None;"
  },

  "JwtSettings": {
    "SecretKey": "URPSystem-CleanArch-SuperSecretKey-2024-MustBe32Chars!",
    "Issuer": "URP.API",
    "Audience": "URP.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },

  "Cors": { "AllowedOrigins": "http://localhost:5173" },
  "AllowedHosts": "*"
}